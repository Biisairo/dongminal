# Build artifact (cmd/dongminal → ./dongminal) — 루트 한정(`cmd/dongminal/` 디렉터리와 충돌 방지)
/dongminal

# Runtime artifacts: internal/runtime.Install 이 생성하는 bin/*
/bin

# Runtime data (DATA_DIR 산출물)
/.dongminal
workspace.json
settings.json
panes.json

# Local env (더 이상 읽히지 않는다 — CLI_CONSOLIDATION_SRS §7)
/.env

# Go test / coverage
*.test
*.out
coverage.txt

# Editor / OS
.DS_Store
.claude/
.idea/
.vscode/

# Node.js / Playwright
node_modules/
playwright-report/
test-results/
# parity-reporter 가 잡 요약에 넘기는 flaky 수 (CI_GATES_SRS §3)
parity-flaky.txt

# Temporary / test data
/tmp/

# script/test_start.sh 가 생성하는 격리 테스트 인스턴스 (PORT=12345)
/.test-dongminal/

.serena

# Playwright MCP 가 스크린샷·스냅샷을 남기는 자리 (검증용 산출물)
.playwright-mcp/

# 배포 빌드 산출물 (scripts/build.sh --all)
/dist/

# 개명 전 빌드 산출물 이름 (히스토리에 9MB급 blob 27개가 남아 있다 — 06-docs-hygiene §4)
/remote-terminal
